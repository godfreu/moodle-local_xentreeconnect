{{!
    @template local_xentreeconnect/connect_button

    "Connect with Xentree" button, or an admin-only notice when the plugin is not configured.

    Context variables required for this template:
    * showbutton - bool
    * adminnotice - bool
    * label - Button text
    * href - Launch URL
    * message - Notice text
    * statusurl - Status page URL
    * statuslabel - Status page link text

    Example context (json):
    {
        "showbutton": true,
        "adminnotice": false,
        "label": "Connect with Xentree",
        "href": "https://moodle.example.com/local/xentreeconnect/launch.php",
        "message": "Xentree Connect is not configured.",
        "statusurl": "https://moodle.example.com/local/xentreeconnect/index.php",
        "statuslabel": "Xentree Connect status"
    }
}}
<div class="local-xentreeconnect my-3" data-region="local-xentreeconnect">
    {{#showbutton}}
        <a class="btn btn-primary" href="{{href}}" role="button" data-action="xentreeconnect-launch">{{label}}</a>
    {{/showbutton}}
    {{#adminnotice}}
        <div class="alert alert-warning mb-0" role="alert">{{message}} <a href="{{statusurl}}">{{statuslabel}}</a></div>
    {{/adminnotice}}
</div>
